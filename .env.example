# ============================================================================
# Autonomous Agentic Trading System — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# --- Application ---
APP_NAME=AutonomousTradingAgent
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG          # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_agent
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret_2024
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- LLM Provider (provider-agnostic) ---
# Options: openai | gemini | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# Google Gemini (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=4096

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Market Data Providers ---
# Alpha Vantage (free API key: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Finnhub (free API key: https://finnhub.io/)
FINNHUB_API_KEY=

# Polygon.io (optional premium)
POLYGON_API_KEY=

# --- Broker: Alpaca ---
# Get keys at: https://app.alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets       # Live trading (DO NOT USE until Phase 8)
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Risk Management Limits ---
# These are HARD limits that the AI CANNOT override
MAX_POSITION_SIZE_PCT=5.0        # Max % of portfolio per position
MAX_PORTFOLIO_LEVERAGE=1.0       # Max leverage (1.0 = no leverage)
MAX_DAILY_LOSS_PCT=2.0           # Max daily loss as % of portfolio
MAX_PORTFOLIO_DRAWDOWN_PCT=10.0  # Max total drawdown as % of peak
MAX_CORRELATED_EXPOSURE_PCT=15.0 # Max exposure to correlated assets
MAX_OPEN_POSITIONS=10            # Max concurrent open positions
MAX_LOSS_PER_TRADE_PCT=1.0       # Max loss per individual trade
REQUIRE_STOP_LOSS=true           # Every trade MUST have a stop loss
MIN_RISK_REWARD_RATIO=1.5        # Minimum reward/risk ratio

# --- Paper Trading ---
PAPER_TRADING_INITIAL_CAPITAL=100000.0
PAPER_TRADING_COMMISSION_PCT=0.1     # Commission per trade (%)
PAPER_TRADING_SLIPPAGE_PCT=0.05      # Simulated slippage (%)
PAPER_TRADING_SPREAD_PCT=0.02        # Simulated bid-ask spread (%)

# --- MCP Server ---
MCP_SERVER_NAME=TradingMCPServer
MCP_AUTH_TOKEN=change-me-to-a-secure-token

# --- Dashboard ---
DASHBOARD_PORT=5173

# --- Monitoring ---
ENABLE_KILL_SWITCH=true
KILL_SWITCH_CHECK_INTERVAL_SEC=30
HEARTBEAT_INTERVAL_SEC=60
